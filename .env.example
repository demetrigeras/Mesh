# Copy this file to .env.local and fill in your sandbox keys.
# Mesh dashboard: Account > API keys (the key needs Read & Write for transfers).
MESH_CLIENT_ID=
MESH_CLIENT_SECRET=

# true  = fake Mesh responses and a simulated Link popup (no credentials needed)
# false = real sandbox calls. This is the one line to change.
# Mock mode is also used automatically when either credential above is empty.
MESH_MOCK=true

# Optional. Defaults to the sandbox.
# MESH_BASE_URL=https://sandbox-integration-api.meshconnect.com
